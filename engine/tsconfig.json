{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@clip/*": ["./sample/*"],
      "@lib/*": ["./src/*"],
      "@config/*": ["../config/*"]
    }
  },
  "include": ["src", "sample"]
}
